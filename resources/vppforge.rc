#include "../src/version.h"

1 ICON "vppforge.ico"
1 VERSIONINFO
FILEVERSION VPP_VERSION_COMMA
PRODUCTVERSION VPP_VERSION_COMMA
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Romek (RomekRF)"
      VALUE "FileDescription", "VPP Forge - Red Faction VPP workbench"
      VALUE "FileVersion", VPP_VERSION
      VALUE "ProductName", "VPP Forge"
      VALUE "ProductVersion", VPP_VERSION
      VALUE "LegalCopyright", "VPP Forge by Romek (RomekRF). Successor to Descent Manager VPPBuilder32 by Heiko Herrmann, Descent Network"
      VALUE "OriginalFilename", "vppforge.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
